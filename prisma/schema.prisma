// Şemada enum yok: sabitler src/lib/constants.ts içinde metin olarak durur.
// Yeni bir durum/rol eklemek göç gerektirmesin diye (CLAUDE.md "Yapma" listesi).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // havuzlanmış (Supabase pooler, 6543)
  directUrl = env("DIRECT_URL") // doğrudan (5432) — migrate/db push (TUZAKLAR #3)
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  status       String   @default("ACTIVE") // PENDING | ACTIVE | FROZEN
  inviteCode   String?  @unique // hesabın hangi davet koduyla açıldığı
  createdAt    DateTime @default(now())

  // E-posta bildirimi. Adres doğrulanmadan bildirim gitmiyor: yanlış yazılan
  // adrese envanter bilgisi gönderilmesin.
  email              String?   @unique
  emailVerifiedAt    DateTime?
  emailReminders     Boolean   @default(true)
  emailCodeHash      String? // doğrulama kodu düz metin saklanmıyor
  emailCodeExpiresAt DateTime?
  emailCodeTries     Int       @default(0)

  // Şifre sıfırlama kodu ayrı tutuluyor: adres doğrulama kodunu sıfırlamak
  // için kullanmak, doğrulanmış adresi de sıfırlardı.
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  resetCodeTries     Int       @default(0)

  memberships       LocationMember[]
  assignedEvents    ItemEvent[]        @relation("EventAssignee")
  assignmentsHeld   ItemAssignment[]   @relation("AssignmentHolder")
  assignmentsGiven  ItemAssignment[]   @relation("AssignmentCreator")
  assignmentsClosed ItemAssignment[]   @relation("AssignmentCloser")
  pushSubscriptions PushSubscription[]
  invitesCreated    LocationInvite[]   @relation("InviteCreator")
  shareLinks        ShareLink[]        @relation("ShareCreator")
  invoiceReads      InvoiceRead[]
  auditLogs         AuditLog[]
  inviteUsed        LocationInvite?    @relation("InviteUser")
  notes             ItemNote[]
  ratings           ItemRating[]
}

model Location {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  createdAt DateTime @default(now())

  members    LocationMember[]
  items      Item[]
  categories Category[]
  vendors    Vendor[]
  invites    LocationInvite[]
  auditLogs  AuditLog[]
}

model LocationMember {
  id         String   @id @default(cuid())
  locationId String
  userId     String
  role       String // OWNER | EDITOR | VIEWER
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([locationId, userId])
  @@index([userId])
}

// Davet kodu lokasyona ve role bağlıdır: kodla kayıt olan kişi doğrudan o
// lokasyonun üyesi olur. Kod tek kullanımlık ve süreli.
model LocationInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  locationId  String
  role        String // OWNER | EDITOR | VIEWER
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique

  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy User     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User?    @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([locationId])
}

model Category {
  id         String   @id @default(cuid())
  locationId String
  name       String
  icon       String?
  createdAt  DateTime @default(now())

  location Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fields   CategoryField[]
  items    Item[]

  @@index([locationId])
}

model CategoryField {
  id         String  @id @default(cuid())
  categoryId String
  key        String
  label      String
  type       String // TEXT | NUMBER | DATE | SELECT | BOOL
  order      Int     @default(0)
  required   Boolean @default(false)
  options    Json? // SELECT için seçenekler
  hidden     Boolean @default(false) // silmek yerine gizle (TUZAKLAR #26)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
}

model Vendor {
  id         String  @id @default(cuid())
  locationId String
  name       String
  phone      String?
  email      String?
  address    String?
  note       String?
  isSeller   Boolean @default(true)
  isService  Boolean @default(false)

  location  Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  soldItems Item[]      @relation("ItemSeller")
  events    ItemEvent[]
  parts     Part[]

  @@index([locationId])
}

model Item {
  id         String  @id @default(cuid())
  locationId String
  categoryId String?
  name       String
  brand      String?
  model      String?
  serialNo   String?
  place      String? // oda/raf — serbest metin

  sellerId           String?
  purchaseDate       DateTime?
  purchasePriceMinor Int? // kuruş
  currency           String    @default("TRY")
  warrantyEndDate    DateTime?

  status       String @default("IN_USE") // IN_USE | IN_REPAIR | RETIRED | SOLD
  customFields Json   @default("{}") // CategoryField tanımlarına göre doğrulanır

  // Alt ekipman: lisans, hoparlör, klavye… kendi garantisi ve faturası olan
  // tam bir ekipman, yalnız bir ana ekipmana bağlı. Ana ekipman silinmiyor
  // (yaşam döngüsüyle çıkıyor) ama yine de bağ koparsa alt ekipman kalmalı.
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location    Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category    Category?         @relation(fields: [categoryId], references: [id])
  seller      Vendor?           @relation("ItemSeller", fields: [sellerId], references: [id])
  parent      Item?             @relation("ItemComponents", fields: [parentId], references: [id], onDelete: SetNull)
  components  Item[]            @relation("ItemComponents")
  attachments Attachment[]
  events      ItemEvent[]
  parts       Part[]
  reminders   ItemReminder[]
  maintenance MaintenanceRule[]
  shareLinks  ShareLink[]
  assignments ItemAssignment[]
  notes       ItemNote[]
  ratings     ItemRating[]

  @@index([locationId, status])
  @@index([locationId, categoryId])
  @@index([serialNo])
  @@index([parentId])
}

// Zimmet — teslim–tesellüm. Ekipmanın "şu anki sorumlusu" saklanmıyor,
// kapanmamış kayıttan türetiliyor (CLAUDE.md).
//
// Sorumlu ya hesabı olan bir üye (`holderUserId`) ya da hesabı olmayan bir
// kişidir (`holderName`): ev halkının tamamının hesabı olmuyor. Hesabı olan
// kişi teslimi kendi onaylıyor; olmayan için sahip/düzenleyen onun adına
// işaretliyor — kimin işaretlediği `closedById`/`acceptedById` ile kayıtta.
model ItemAssignment {
  id           String   @id @default(cuid())
  itemId       String
  holderUserId String?
  holderName   String?
  assignedById String
  assignedAt   DateTime @default(now())
  note         String?

  acceptedAt   DateTime?
  acceptedById String? // kişinin kendisi ya da adına işaretleyen üye
  closedAt     DateTime?
  closedReason String? // RETURN | TRANSFER | DECLINE
  closedById   String?

  item       Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  holderUser User? @relation("AssignmentHolder", fields: [holderUserId], references: [id], onDelete: Cascade)
  assignedBy User  @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: Cascade)
  closedBy   User? @relation("AssignmentCloser", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([itemId, assignedAt])
  @@index([holderUserId, closedAt])
}

// Tekrarlayan bakım kuralı: "6 ayda bir" ya da "her 10.000 km'de".
// Son bakım tarihi ve son okuma kayıtlardan hesaplanır, burada saklanmaz;
// `lastNotifiedCycle` yalnız bildirim defteri — sayaç turunun aynı bildirimi
// iki kez göndermesini engelliyor (TUZAKLAR #28'in sayaç tarafı).
model MaintenanceRule {
  id                String   @id @default(cuid())
  itemId            String
  name              String
  everyMonths       Int?
  everyReading      Float?
  readingUnit       String?
  leadDays          Int      @default(7)
  lastNotifiedCycle Int?
  createdAt         DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Salt-okunur paylaşım linki: servise giderken teknisyene geçmişi hesap
// açtırmadan göstermek için. Süreli ve iptal edilebilir; tutarlar
// paylaşılmıyor.
model ShareLink {
  id           String    @id @default(cuid())
  token        String    @unique
  itemId       String
  createdById  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User @relation("ShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Attachment {
  id         String   @id @default(cuid())
  itemId     String
  url        String
  path       String // depolamadaki nesne yolu; silerken gerekiyor
  name       String
  kind       String // PHOTO | INVOICE | WARRANTY | MANUAL | OTHER
  mimeType   String?
  uploadedAt DateTime @default(now())

  // Not fotoğrafı da burada duruyor: depolama yolu ve silme tek yerde kalsın.
  // Doluysa dosya ekipmanın genel ekler bölümünde değil, notun içinde çıkıyor.
  noteId String?

  item Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  note ItemNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([noteId])
}

// Kullanıcı notu: tarif, deneme, ayar, uyarı… Ekipmanın "nasıl kullanılıyor"
// tarafı. Zaman çizelgesi olayları olan biteni tutuyor, notlar bilgiyi.
model ItemNote {
  id         String   @id @default(cuid())
  itemId     String
  userId     String? // kullanıcı silinse de not kalsın
  // Yazarın o günkü adı: kullanıcı silinirse "kim yazmış" kaybolmasın.
  authorName String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item        Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([itemId, createdAt])
}

// Beğeni yıldızı: kullanıcı başına tek puan. "Hangi makine gerçekten
// kullanılıyor" sorusunun cevabı; ortalama hesaplanıyor, saklanmıyor
// (CLAUDE.md: türetilmiş değer saklanmaz).
model ItemRating {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId])
}

model ItemEvent {
  id     String   @id @default(cuid())
  itemId String
  date   DateTime
  kind   String // READING | SERVICE | LOG | ASSIGNMENT
  note   String?

  readingValue Float? // km, saat, sayfa — metin değil (bakım kuralı buna bakar)
  readingUnit  String?

  costMinor Int? // kuruş
  vendorId  String?

  assignedToUserId String?
  assignedPlace    String?

  createdAt DateTime @default(now())

  item           Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor         Vendor? @relation(fields: [vendorId], references: [id])
  assignedToUser User?   @relation("EventAssignee", fields: [assignedToUserId], references: [id])

  @@index([itemId, date])
}

model Part {
  id         String  @id @default(cuid())
  itemId     String
  name       String
  partNo     String?
  priceMinor Int? // kuruş
  vendorId   String?
  stock      Int?

  item   Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([itemId])
}

model ItemReminder {
  id       String    @id @default(cuid())
  itemId   String
  kind     String // WARRANTY | MAINTENANCE
  dueDate  DateTime
  leadDays Int       @default(30)
  sentAt   DateTime? // damgalanmazsa cron her gün tekrar gönderir (TUZAKLAR #28)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, kind, dueDate, leadDays])
  @@index([dueDate])
}

// Fatura okuma kullanım kaydı. İki işi var: kullanıcı başına hız sınırı
// (TUZAKLAR #37 — açık bir uç faturayı şişirir) ve harcamanın izi.
model InvoiceRead {
  id           String   @id @default(cuid())
  userId       String
  // Okuma ekipman açılmadan da yapılabiliyor (yeni ekipman formunda faturayı
  // taratıp alanları doldurmak): o durumda bağlanacak kayıt henüz yok.
  itemId       String?
  attachmentId String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Denetim izi: kim neyi sildi/değiştirdi. Silinen kaydın kendisi geri
// gelmiyor ama izi kalıyor — paylaşılan bir envanterde "bu nereye gitti"
// sorusunun tek cevabı bu.
model AuditLog {
  id         String   @id @default(cuid())
  locationId String
  userId     String? // kullanıcı silinse de iz kalsın
  action     String // CREATE | UPDATE | DELETE
  entity     String // ITEM | EVENT | PART | ATTACHMENT | MEMBER | CATEGORY | SHARE | LOCATION
  entityId   String?
  summary    String // Türkçe tek cümle: ekranda okunan şey bu
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([locationId, createdAt])
}

// Web push aboneliği kullanıcı başına saklanır (MIMARI §4).
// 410 Gone dönen abonelik silinir (TUZAKLAR #29).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
