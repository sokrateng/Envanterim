# Supabase Postgres — iki adres de gerekli (docs/TUZAKLAR.md #3).
# Havuzlanmış (pooler, 6543): uygulama sorguları
DATABASE_URL="postgresql://postgres.PROJE:SIFRE@aws-0-BOLGE.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Doğrudan (5432): prisma migrate / db push
DIRECT_URL="postgresql://postgres.PROJE:SIFRE@aws-0-BOLGE.pooler.supabase.com:5432/postgres"

# NextAuth — `openssl rand -base64 32` ile üret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Dosya depolama (fotoğraf, fatura, garanti belgesi, kılavuz).
# Tanımsızsa dosyalar .uploads/ altına, yerel diske düşer — geliştirme için
# yeterli, üretimde DEĞİL: sunucusuz dosya sistemi kalıcı değil.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="ekler"

# Faturadan otomatik doldurma. İki sağlayıcıdan biri yeter; ikisi de tanımsızsa
# özellik arayüzde hiç görünmez. YALNIZ SUNUCUDA kalır — asla NEXT_PUBLIC_ olmaz.
#
# Yol 1 — Anthropic (varsa öncelikli):
ANTHROPIC_API_KEY=""
#
# Yol 2 — Azure AI Foundry'deki OpenAI uyumlu dağıtım.
# Uç `/openai/v1` ile biter; dağıtım adı model adı değil, kaynağa açtığın
# dağıtımın adıdır. Ayarı denemek için: npm run llm:test
AZURE_AI_ENDPOINT=""
AZURE_AI_DEPLOYMENT=""
# Kimlik için ikisinden biri:
#  a) Kaynak anahtarı — en kolayı, Vercel'de de çalışır.
AZURE_AI_API_KEY=""
#  b) Entra ID uygulama kaydı (kaynakta yerel kimlik kapalıysa). Uygulama
#     kaydına kaynak üzerinde "Cognitive Services OpenAI User" rolü verilmeli.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Garanti bildirimi (web push). Tanımsızsa bildirim bölümü arayüzde görünmez.
# Anahtarlar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Adres olmalı: "mailto:..." ya da "https://...". Etiket yazılırsa bildirim
# kapalı kalır (TUZAKLAR #52).
VAPID_SUBJECT="mailto:sen@example.com"

# E-posta bildirimi. Tanımsızsa hesap ekranında bölüm hiç görünmez ve
# "şifremi unuttum" bağlantısı çıkmaz.
#
# Gmail / Google Workspace ile (en kolay yol):
#   1. Hesapta iki adımlı doğrulamayı aç.
#   2. Google Hesabı → Güvenlik → Uygulama şifreleri'nden 16 haneli bir şifre
#      üret (normal hesap şifresi SMTP'de çalışmıyor).
#   3. Adreste @ işaretini %40 olarak yaz:
#      smtps://kullanici%40gmail.com:uygulamasifresi@smtp.gmail.com:465
#
# 465 → şema `smtps://` (doğrudan TLS), 587 → `smtp://` (STARTTLS).
# SMTP_FROM, SMTP_URL'deki kullanıcıyla **aynı adres** olmalı: Gmail başka
# adresten göndertmiyor. Ayarı denemek için: npm run mail:test -- sen@ornek.com
SMTP_URL=""
SMTP_FROM="Envanterim <bildirim@ornek.com>"

# Vercel Cron ucunu korur; cron isteği Authorization: Bearer ile geliyor.
CRON_SECRET=""
